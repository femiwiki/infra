local.file "prometheus_password" {
  filename  = "/etc/alloy/prometheus.password"
  is_secret = true
}

local.file "loki_password" {
  filename  = "/etc/alloy/loki.password"
  is_secret = true
}

prometheus.exporter.self "alloy_check" { }

discovery.relabel "alloy_check" {
  targets = prometheus.exporter.self.alloy_check.targets

  rule {
    target_label = "instance"
    replacement  = "${name}"
  }

  rule {
    target_label = "alloy_hostname"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/alloy-check"
  }
}

prometheus.scrape "alloy_check" {
  targets    = discovery.relabel.alloy_check.output
  forward_to = [prometheus.relabel.alloy_check.receiver]

  scrape_interval = "60s"
}

prometheus.relabel "alloy_check" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = string.join([
      "prometheus_target_sync_length_seconds_sum",
      "prometheus_target_scrapes_.*",
      "prometheus_target_interval.*",
      "prometheus_sd_discovered_targets",
      "alloy_build.*",
      "prometheus_remote_write_wal_samples_appended_total",
      "process_start_time_seconds",
      "process_resident_memory_bytes",
      "loki_process_custom_rate_limit_refusals_total",
      "loki_process_custom_php_deprecations_total",
    ], "|")
    action        = "keep"
  }
}

prometheus.remote_write "metrics_service" {
  endpoint {
    url = "${prometheus_endpoint}"

    basic_auth {
      username = "${prometheus_username}"
      password = local.file.prometheus_password.content
    }
  }
}

loki.write "grafana_cloud_loki" {
  endpoint {
    url = "${loki_endpoint}"

    basic_auth {
      username = "${loki_username}"
      password = local.file.loki_password.content
    }
  }
}

// Linux
discovery.relabel "integrations_node_exporter" {
  targets = prometheus.exporter.unix.integrations_node_exporter.targets
  rule {
    target_label = "instance"
    replacement  = "${name}"
  }
  rule {
    target_label = "job"
    replacement = "integrations/node_exporter"
  }
}
prometheus.exporter.unix "integrations_node_exporter" {
  disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
    mount_timeout        = "5s"
  }
  netclass {
    ignored_devices = "^(veth.*|cali.*|[a-f0-9]{15})$"
  }
  netdev {
    device_exclude = "^(veth.*|cali.*|[a-f0-9]{15})$"
  }
}
prometheus.scrape "integrations_node_exporter" {
  targets    = discovery.relabel.integrations_node_exporter.output
  forward_to = [prometheus.relabel.integrations_node_exporter.receiver]
}
prometheus.relabel "integrations_node_exporter" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]
  rule {
    source_labels = ["__name__"]
    regex         = "node_scrape_collector_.+"
    action        = "drop"
  }
}

%{ if type == "app" ~}
// Caddy, on its admin endpoint
prometheus.scrape "caddy" {
  targets    = [{__address__ = "127.0.0.1:2019", instance = "${name}", job = "integrations/caddy"}]
  forward_to = [prometheus.relabel.caddy.receiver]
}
prometheus.relabel "caddy" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]
  rule {
    source_labels = ["__name__"]
    regex         = "caddy_rate_limit_.+"
    action        = "drop"
  }
}

// Caddy's pprof, also on the admin endpoint. A minute apart keeps it far under
// the free plan's 50 GB of profiles a month: about 60 KB a scrape, 2.5 GB.
pyroscope.scrape "caddy" {
  targets    = [{__address__ = "127.0.0.1:2019", instance = "${name}", service_name = "caddy"}]
  forward_to = [pyroscope.write.grafana_cloud.receiver]

  scrape_interval = "60s"

  profiling_config {
    // Caddy never sets a mutex or block profile rate, so these come back empty.
    profile.mutex {
      enabled = false
    }
    profile.block {
      enabled = false
    }
  }
}
pyroscope.write "grafana_cloud" {
  endpoint {
    url = "${pyroscope_endpoint}"

    basic_auth {
      username = "${pyroscope_username}"
      // The metrics token also carries profiles:write.
      password = local.file.prometheus_password.content
    }
  }
}

// php-fpm's pool status and opcache, served by Caddy on a loopback port that
// alternates with the deploy generation like the probe port
// (femiwiki/docker-mediawiki#1110). Outside a deploy only one of the two ports
// answers, so the other's targets are down.
prometheus.scrape "php_fpm" {
  targets = [
%{ for port in [9180, 9181] ~}
    {__address__ = "127.0.0.1:${port}", __metrics_path__ = "/fpm-status", instance = "${name}", job = "integrations/php-fpm", port = "${port}"},
    {__address__ = "127.0.0.1:${port}", __metrics_path__ = "/opcache.php", instance = "${name}", job = "integrations/opcache", port = "${port}"},
%{ endfor ~}
  ]
  // php-fpm answers in OpenMetrics only when asked; opcache.php ignores it
  params     = {"openmetrics" = [""]}
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  scrape_interval = "60s"
}

// Per-container memory, read from the Docker daemon's cgroups
prometheus.exporter.cadvisor "containers" {
  docker_only               = true
  disable_root_cgroup_stats = true
  store_container_labels    = false
  enabled_metrics           = ["memory"]
  storage_duration          = "1m"
}
discovery.relabel "containers" {
  targets = prometheus.exporter.cadvisor.containers.targets
  rule {
    target_label = "instance"
    replacement  = "${name}"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/cadvisor"
  }
}
prometheus.scrape "containers" {
  targets    = discovery.relabel.containers.output
  forward_to = [prometheus.relabel.containers.receiver]

  scrape_interval = "60s"
}
prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]
  rule {
    source_labels = ["__name__"]
    regex         = "container_memory_(working_set_bytes|max_usage_bytes|usage_bytes|rss)|container_spec_memory_limit_bytes"
    action        = "keep"
  }
  rule {
    source_labels = ["name"]
    regex         = ".+"
    action        = "keep"
  }
  rule {
    regex  = "id|image"
    action = "labeldrop"
  }
}

prometheus.exporter.memcached "memcached" {
  address = "127.0.0.1:11211"
}
discovery.relabel "memcached" {
  targets = prometheus.exporter.memcached.memcached.targets
  rule {
    target_label = "instance"
    replacement  = "${name}"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/memcached"
  }
}
prometheus.scrape "memcached" {
  targets    = discovery.relabel.memcached.output
  forward_to = [prometheus.relabel.memcached.receiver]

  scrape_interval = "60s"
}
prometheus.relabel "memcached" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]
  rule {
    source_labels = ["__name__"]
    regex         = "memcached_(up|limit_bytes|current_bytes|current_items|items_evicted_total|items_reclaimed_total|commands_total|slab_items_evicted_time_seconds)"
    action        = "keep"
  }
  rule {
    source_labels = ["__name__", "command"]
    regex         = "memcached_commands_total;(delete|incr|decr|cas|touch|flush)"
    action        = "drop"
  }
}

%{ endif ~}
// Docker. Alloy's discovery.docker does not support the default type
// https://github.com/grafana/loki/issues/6165#issuecomment-1969418500
// 
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "docker_container_name"
  }
  rule {
    source_labels = ["__journal_container_id"]
    target_label  = "docker_container_id"
  }
}
loki.source.journal "read"  {
  forward_to    = [loki.process.fastcgi.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = {component = "loki.source.journal"}
}

// Container logs are read from the daemon, and carry the same labels as the
// journal ones so a query does not have to know which path a line took. Every
// container is collected rather than a named list: each one sets
// log_driver = "local", so none reaches the journal and there is nothing to
// ship twice. A list only decides which container is missing when something
// goes wrong, and on 2026-09-27 that was ProxySQL, absent from it through the
// database switchover it was introduced for. A container logging to the
// journal would need excluding here; none does.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}
discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "docker_container_name"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "docker_container_id"
  }
  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
}
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.container_logs.output
  forward_to = [loki.process.fastcgi.receiver]
  labels     = {component = "loki.source.docker"}
}
loki.process "fastcgi" {
  forward_to = [loki.write.grafana_cloud_loki.receiver]

  stage.match {
    // The container name carries the generation, so an exact match stopped
    // finding it when the zero-downtime swap started numbering the names.
    selector = "{docker_container_name=~\"fastcgi.*\"}"

    stage.regex {
      expression = "^NOTICE: PHP message: (?P<line>\\{.*)$"
    }

    stage.output {
      source = "line"
    }
  }

  // A label of their own lets the rules waiting on the cron jobs' finish lines
  // read only them: Loki bills a query by the streams it opens
  stage.match {
    selector = `{docker_container_name=~"fastcgi.*"} |~ "^(generate-sitemap|publish-dump): "`

    stage.regex {
      expression = `^(?P<cron_job>generate-sitemap|publish-dump): `
    }

    stage.labels {
      values = {cron_job = ""}
    }
  }

  // A deprecation is logged twice: php-fpm's line is counted and dropped, and
  // MediaWiki's JSON line, which has the URL, is kept at one a minute for each
  stage.match {
    selector = `{docker_container_name=~"fastcgi.*"} |~ "^NOTICE: PHP message: PHP Deprecated: "`

    // The last that matches names it: the message without its caller, else
    // the deprecated method, else the skin menu
    stage.regex {
      expression = `PHP Deprecated: +(?P<deprecation>.*?)(?: \[Called from .*)?(?: in /\S+ on line \d+)?$`
    }
    stage.regex {
      expression = `PHP Deprecated: +Use of (?P<deprecation>\S+) was deprecated`
    }
    stage.regex {
      expression = `PHP Deprecated: .*<br>(?P<deprecation>[^<]*?) is deprecated\.`
    }

    stage.labels {
      values = {deprecation = ""}
    }

    stage.metrics {
      metric.counter {
        name        = "php_deprecations_total"
        description = "PHP Deprecated messages, by what is deprecated"
        match_all   = true
        action      = "inc"
      }
    }
  }
  stage.match {
    selector            = `{docker_container_name=~"fastcgi.*"} |~ "^NOTICE: PHP message: PHP Deprecated: "`
    action              = "drop"
    drop_counter_reason = "php_deprecation_fpm_copy"
  }
  stage.match {
    selector = `{docker_container_name=~"fastcgi.*"} |= "\"channel\":\"error\"" |= "PHP Deprecated: "`

    stage.json {
      expressions = {deprecation_message = "context.exception.message"}
    }

    stage.regex {
      source     = "deprecation_message"
      expression = `PHP Deprecated: +(?P<deprecation>.*?)(?: \[Called from .*)?(?: in /\S+ on line \d+)?$`
    }
    stage.regex {
      source     = "deprecation_message"
      expression = `PHP Deprecated: +Use of (?P<deprecation>\S+) was deprecated`
    }
    stage.regex {
      source     = "deprecation_message"
      expression = `PHP Deprecated: .*<br>(?P<deprecation>[^<]*?) is deprecated\.`
    }

    stage.labels {
      values = {deprecation = ""}
    }

    stage.limit {
      rate          = 1.0 / 60
      burst         = 1
      by_label_name = "deprecation"
      drop          = true
    }

    stage.label_drop {
      values = ["deprecation"]
    }
  }

  // A refused request is logged twice: the rate limiter's own line, and the
  // access log line for the 429. The first carries the zone but only the
  // connection address, which behind CloudFront is an edge (femiwiki#639). The
  // second carries the reader's client_ip but is ten times the size: on
  // 2026-09-30 it was 29.7% of what was still leaving the box after #967. So
  // the second is cut down to the address and the URI, which is what
  // grafana/queries/concentrated-refusals.logql and the scrapes dashboard read.
  // It has no status, so the queries counting responses still leave 429s out.
  stage.match {
    selector = `{docker_container_name=~"http.*"} |= "\"status\":429"`

    stage.json {
      expressions = {client_ip = "request.client_ip", uri = "request.uri"}
    }

    stage.template {
      source   = "refused"
      template = `{{ dict "msg" "refused" "client_ip" .client_ip "uri" .uri | toJson }}`
    }

    stage.output {
      source = "refused"
    }
  }

  // Refusals per zone outlive the log lines, so an unused zone shows as zero
  stage.match {
    selector = `{docker_container_name=~"http.*"} |= "\"logger\":\"http.handlers.rate_limit\"" |= "rate limit exceeded"`

    stage.json {
      expressions = {zone = "zone"}
    }

    stage.labels {
      values = {zone = ""}
    }

    stage.metrics {
      metric.counter {
        name        = "rate_limit_refusals_total"
        description = "Requests Caddy's rate_limit refused, by zone"
        match_all   = true
        action      = "inc"
      }
    }

    stage.label_drop {
      values = ["zone"]
    }
  }
}
