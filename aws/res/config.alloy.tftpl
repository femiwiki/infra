local.file "prometheus_password" {
  filename  = "/etc/alloy/prometheus.password"
  is_secret = true
}

prometheus.exporter.self "alloy_check" { }

discovery.relabel "alloy_check" {
  targets = prometheus.exporter.self.alloy_check.targets

  rule {
    target_label = "instance"
    replacement  = "${name}"
  }

  rule {
    target_label = "alloy_hostname"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/alloy-check"
  }
}

prometheus.scrape "alloy_check" {
  targets    = discovery.relabel.alloy_check.output
  forward_to = [prometheus.relabel.alloy_check.receiver]

  scrape_interval = "60s"
}

prometheus.relabel "alloy_check" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = string.join([
      "prometheus_target_sync_length_seconds_sum",
      "prometheus_target_scrapes_.*",
      "prometheus_target_interval.*",
      "prometheus_sd_discovered_targets",
      "alloy_build.*",
      "prometheus_remote_write_wal_samples_appended_total",
      "process_start_time_seconds",
      "process_resident_memory_bytes",
    ], "|")
    action        = "keep"
  }
}

prometheus.remote_write "metrics_service" {
  endpoint {
    url = "${prometheus_endpoint}"

    basic_auth {
      username = "${prometheus_username}"
      password = local.file.prometheus_password.content
    }
  }
}

// Caddy's pprof, also on the admin endpoint. A minute apart keeps it far under
// the free plan's 50 GB of profiles a month: about 60 KB a scrape, 2.5 GB.
pyroscope.scrape "caddy" {
  targets    = [{__address__ = "127.0.0.1:2019", instance = "${name}", service_name = "caddy"}]
  forward_to = [pyroscope.write.grafana_cloud.receiver]

  scrape_interval = "60s"

  profiling_config {
    // Caddy never sets a mutex or block profile rate, so these come back empty.
    profile.mutex {
      enabled = false
    }
    profile.block {
      enabled = false
    }
  }
}
pyroscope.write "grafana_cloud" {
  endpoint {
    url = "${pyroscope_endpoint}"

    basic_auth {
      username = "${pyroscope_username}"
      // The metrics token also carries profiles:write.
      password = local.file.prometheus_password.content
    }
  }
}
