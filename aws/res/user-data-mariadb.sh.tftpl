#!/bin/bash
set -euo pipefail; IFS=$'\n\t'

# Enable verbose mode
set -x

#
# Install ec2-instance-connect and SSMAgent
# Reference: https://docs.aws.amazon.com/systems-manager/latest/userguide/agent-install-al2.html
#
dnf install -y ec2-instance-connect
dnf install -y "https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_$(uname -m | sed 's/x86_64/amd64/; s/aarch64/arm64/')/amazon-ssm-agent.rpm"

#
# Install basic utilities
#
dnf autoremove -y postfix
# - ripgrep: Disabled temporarily (https://github.com/femiwiki/femiwiki/issues/247)
dnf install -y \
  awscli-2 \
  bash-completion \
  bind-utils \
  git \
  htop \
  jq \
  nc \
  pv \
  tmux \
  unzip \
  vim-enhanced \
  xfsprogs \
;

#
# Install atop and sysstat
# Reference: https://repost.aws/knowledge-center/ec2-linux-configure-monitoring-tools
#
dnf -y install sysstat atop
sed -i 's/^LOGINTERVAL=600.*/LOGINTERVAL=60/' /etc/sysconfig/atop
mkdir -v /etc/systemd/system/sysstat-collect.timer.d/
bash -c "sed -e 's|every 10 minutes|every 1 minute|g' -e '/^OnCalendar=/ s|/10$|/1|' /usr/lib/systemd/system/sysstat-collect.timer > /etc/systemd/system/sysstat-collect.timer.d/override.conf"
sed -i 's|^SADC_OPTIONS=.*|SADC_OPTIONS=" -S XALL"|' /etc/sysconfig/sysstat
systemctl enable atop.service atop-rotate.timer sysstat-collect.timer sysstat.service
systemctl restart atop.service atop-rotate.timer sysstat-collect.timer sysstat.service

#
# Install and configure Grafana Alloy
#
curl -sLo gpg.key https://rpm.grafana.com/gpg.key
rpm --import gpg.key && rm gpg.key
echo -e '[grafana]\nname=grafana\nbaseurl=https://rpm.grafana.com\nrepo_gpgcheck=1\nenabled=1\ngpgcheck=1\ngpgkey=https://rpm.grafana.com/gpg.key\nsslverify=1
sslcacert=/etc/pki/tls/certs/ca-bundle.crt' | tee /etc/yum.repos.d/grafana.repo
dnf install -y alloy
systemctl enable alloy
bash <<'ALLOY_INSTALL'
${alloy_install}
ALLOY_INSTALL

#
# Configure sudo to allow running commands in /usr/local/{bin,sbin}
#
cat <<'EOF' > /etc/sudoers.d/10-sudo-path
Defaults secure_path=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
EOF

# Add hostname to /etc/hosts
# https://github.com/hashicorp/nomad/blob/v1.8.4/terraform/shared/scripts/server.sh
echo "127.0.0.1 $(hostname)" | tee --append /etc/hosts

#
# Create htoprc
#
sudo -u ec2-user mkdir -p /home/ec2-user/.config/htop
sudo -u ec2-user tee /home/ec2-user/.config/htop/htoprc <<'EOF' >/dev/null
header_margin=1
hide_kernel_threads=1
hide_userland_threads=1
highlight_base_name=1
highlight_megabytes=1
tree_view=1
EOF


# Install MariaDB
#
# From the distribution, not a hand-downloaded bundle: this is half the reason
# for the engine change, because a security update becomes dnf update. See
# femiwiki/femiwiki#491.
dnf install -y mariadb1011-server
cat <<'EOF' > /etc/my.cnf.d/femiwiki.cnf
[mysqld]
datadir=/var/lib/mysql/data
performance_schema=OFF
max_connections=90 # default to 151

server_id=${mysql_server_id}
log_bin=mysql-bin

# Replication from a MySQL 8.0 primary attaches by file and position, because
# MariaDB's GTID is a different format and does not continue MySQL's. Nothing
# here turns MariaDB's own GTID on or off: it is always recorded.
# sorted alphabetically
innodb_buffer_pool_size=768M
innodb_flush_method=O_DIRECT_NO_FSYNC
innodb_log_file_size=256M
join_buffer_size=1M # default to 256K
max_heap_table_size=32M # default to 16M
tmp_table_size=32M # defaults to 16M
EOF
mkdir -p /etc/systemd/system/mariadb.service.d
cat <<'UNIT' > /etc/systemd/system/mariadb.service.d/10-datadir-mount.conf
[Unit]
RequiresMountsFor=/var/lib/mysql/data
UNIT
systemctl daemon-reload
if ! file -s /dev/nvme1n1 | grep -q "filesystem data"; then
  mkfs.xfs /dev/nvme1n1
  mkdir -p /var/lib/mysql/data
  chown mysql:mysql /var/lib/mysql/data
  grep -q " /var/lib/mysql/data " /etc/fstab || echo "UUID=$(blkid -s UUID -o value /dev/nvme1n1)  /var/lib/mysql/data  xfs  defaults,noatime,nofail  0  2" >> /etc/fstab
  mount /var/lib/mysql/data
  systemctl enable --now mariadb
  #
  # Tracing is off from here on: this part handles root's password and then the
  # application account's, and /var/log/cloud-init-output.log is world readable.
  #
  set +x
  export AWS_DEFAULT_REGION=${region}
  #
  # A fresh MariaDB has no temporary password to find in the journal: the
  # package initialises the data directory with root@localhost authenticating
  # over the unix socket. Both are kept, so root can always log in on the
  # console and the password in Parameter Store is what a replacement uses.
  # femiwiki/infra#652 is about a host nobody could administer.
  ROOT_PASSWORD="$(head -c 24 /dev/urandom | base64 | tr -d '\n')Aa1!"
  mysql -uroot <<SQL
ALTER USER 'root'@'localhost' IDENTIFIED VIA unix_socket OR mysql_native_password USING PASSWORD('$ROOT_PASSWORD');
SQL
  aws ssm put-parameter --name /mysql/servers/${mysql_server_id}/root/password \
    --type SecureString --value "$ROOT_PASSWORD" --overwrite > /dev/null

  MEDIAWIKI_USER="$(aws ssm get-parameter --name /mysql/users/mediawiki/username --query Parameter.Value --output text)"
  MEDIAWIKI_PASSWORD="$(aws ssm get-parameter --name /mysql/users/mediawiki/password --with-decryption --query Parameter.Value --output text)"
  # No validate_password here: MariaDB does not load the plugin, so the account
  # older than any password policy goes in without the LOW/MEDIUM dance the
  # MySQL host needs.
  mysql -uroot <<SQL
CREATE DATABASE femiwiki CHARACTER SET binary;
CREATE USER '$MEDIAWIKI_USER'@'%' IDENTIFIED BY '$MEDIAWIKI_PASSWORD';
GRANT RELOAD, PROCESS ON *.* TO '$MEDIAWIKI_USER'@'%';
GRANT ALL PRIVILEGES ON femiwiki.* TO '$MEDIAWIKI_USER'@'%';
SQL

  #
  # Restore the newest backup, so that replacing this host is the restore. Only
  # a fresh volume reaches here, so there is nothing to overwrite.
  #
  BACKUP_KEY="mysql/$(aws s3 ls s3://${backups_bucket}/mysql/ | tail -1 | awk '{print $4}')"
  echo "Restoring from s3://${backups_bucket}/$BACKUP_KEY"
  aws s3 cp --no-progress "s3://${backups_bucket}/$BACKUP_KEY" /var/lib/mysql/restore.sql.gz
  # Two rewrites, both of things only a MySQL dump contains.
  #
  # mysqldump on a primary with gtid_mode=ON writes SET @@GLOBAL.GTID_PURGED,
  # and MariaDB has no such variable: it keeps its position in gtid_slave_pos.
  # The line is dropped rather than the dump being retaken, because the dump
  # this restores from is the nightly one and it is not ours to change.
  #
  # utf8mb4_0900_ai_ci does not exist in MariaDB. It reaches the dump because
  # searchindex and translate_tmf are the only tables MediaWiki creates without
  # naming a charset -- a FULLTEXT index needs a real one -- so they inherit the
  # server default, which on MySQL 8.0 is that collation. utf8mb4_general_ci is
  # what MariaDB would have given them, and the column data carries no collation
  # of its own, so rewriting the name is the whole of it. Once this host is the
  # one being dumped, its own dumps say general_ci and the rewrite stops
  # matching anything.
  POOL="$(mysql -uroot -N -B -e 'SELECT @@innodb_buffer_pool_size;')"
  mysql -uroot -e "SET GLOBAL innodb_buffer_pool_size = 268435456;"
  zcat /var/lib/mysql/restore.sql.gz \
    | sed -e '/^SET @@GLOBAL.GTID_PURGED=/d' -e 's/utf8mb4_0900_ai_ci/utf8mb4_general_ci/g' \
    | mysql -uroot femiwiki
  mysql -uroot -e "SET GLOBAL innodb_buffer_pool_size = $POOL;"
  rm -f /var/lib/mysql/restore.sql.gz
  # A restore that leaves no revisions is a failure, not a quiet empty wiki.
  REVISIONS="$(mysql -uroot -N -B -e 'SELECT COUNT(*) FROM femiwiki.revision;')"
  echo "restored revisions: $REVISIONS"
  [ "$REVISIONS" -gt 0 ]

  # The dump account and its credentials, so that the host can back itself up
  # the moment it is the one being read. The timer is not enabled here: while
  # this host is a replica a second nightly dump would land in the same prefix
  # and could become the newest key, which is what a restore takes. The SSM
  # document install-mysql-backup-database-${mysql_server_id} turns it on.
  BACKUP_PASSWORD="$(head -c 24 /dev/urandom | base64 | tr -d '\n')Aa1!"
  mysql -uroot <<SQL
CREATE USER 'backup'@'localhost' IDENTIFIED BY '$BACKUP_PASSWORD';
GRANT RELOAD, PROCESS ON *.* TO 'backup'@'localhost';
GRANT SELECT, SHOW VIEW, TRIGGER ON femiwiki.* TO 'backup'@'localhost';
SQL
  install -m 600 /dev/null /root/.my.cnf
  cat <<CNF > /root/.my.cnf
[mysqldump]
user=backup
password=$BACKUP_PASSWORD
single-transaction
CNF
  # An account that cannot dump is a backup that does not exist. The schema
  # alone exercises the login, the grants and the read lock in a second.
  mysqldump --defaults-file=/root/.my.cnf --no-data femiwiki > /dev/null
  set -x
else
  mkdir -p /var/lib/mysql/data
  chown mysql:mysql /var/lib/mysql/data
  grep -q " /var/lib/mysql/data " /etc/fstab || echo "UUID=$(blkid -s UUID -o value /dev/nvme1n1)  /var/lib/mysql/data  xfs  defaults,noatime,nofail  0  2" >> /etc/fstab
  mount /var/lib/mysql/data
  systemctl enable --now mariadb
fi

#
# Create README
#
sudo -u ec2-user tee /home/ec2-user/README <<'EOF' >/dev/null
https://github.com/femiwiki/infra
EOF
