extensions:
  basicauth/metrics_service:
    client_auth:
      username: "${prometheus_username}"
      password: $${file:/etc/otelcol-contrib/prometheus.password}

  basicauth/logs_service:
    client_auth:
      username: "${loki_username}"
      password: $${file:/etc/otelcol-contrib/loki.password}
%{ if type == "app" ~}

  basicauth/profiles_service:
    client_auth:
      username: "${pyroscope_username}"
      # The metrics token also carries profiles:write
      password: $${file:/etc/otelcol-contrib/prometheus.password}
%{ endif ~}

receivers:
  prometheus:
    config:
      global:
        scrape_interval: 60s
      scrape_configs:
        - job_name: integrations/otelcol
          static_configs:
            - targets: [127.0.0.1:8888]
              labels:
                instance: ${name}
          metric_relabel_configs:
            - source_labels: [__name__]
              regex: otelcol_process_memory_rss.*|otelcol_process_uptime.*|otelcol_exporter_sent_metric_points.*|otelcol_exporter_send_failed_metric_points.*|otelcol_receiver_refused_metric_points.*
              action: keep

        - job_name: integrations/node_exporter
          static_configs:
            - targets: [127.0.0.1:9110]
              labels:
                instance: ${name}
          metric_relabel_configs:
            - source_labels: [__name__]
              regex: node_scrape_collector_.+
              action: drop
%{ if type == "app" ~}

        # Caddy, on its admin endpoint
        - job_name: integrations/caddy
          static_configs:
            - targets: [127.0.0.1:2019]
              labels:
                instance: ${name}
          metric_relabel_configs:
            - source_labels: [__name__]
              regex: caddy_rate_limit_.+
              action: drop

        # Served by Caddy on a port that alternates with the deploy generation
        # (femiwiki/docker-mediawiki#1110), so one of the two is always down
        - job_name: integrations/php-fpm
          metrics_path: /fpm-status
          # php-fpm answers in OpenMetrics only when asked
          params:
            openmetrics: [""]
          static_configs:
%{ for port in [9180, 9181] ~}
            - targets: [127.0.0.1:${port}]
              labels:
                instance: ${name}
                port: "${port}"
%{ endfor ~}

        - job_name: integrations/opcache
          metrics_path: /opcache.php
          static_configs:
%{ for port in [9180, 9181] ~}
            - targets: [127.0.0.1:${port}]
              labels:
                instance: ${name}
                port: "${port}"
%{ endfor ~}

  # Per-container memory, from the Docker daemon
  docker_stats:
    endpoint: unix:///var/run/docker.sock
    collection_interval: 60s

  memcached:
    endpoint: 127.0.0.1:11211
    transport: tcp
    collection_interval: 60s

  # Docker's fluentd log driver, which every container uses
  fluent_forward:
    endpoint: 127.0.0.1:24224

  # Caddy's pprof, on its admin endpoint. A minute apart keeps it far under the
  # free plan's 50 GB of profiles a month. The CPU profile covers all but a
  # second of each minute, as Alloy's did. The memory profile is left out: each
  # allocation size would become a series of its own (#1259).
  pprof/caddy_cpu:
    remote:
      endpoint: http://127.0.0.1:2019/debug/pprof/profile?seconds=59
      collection_interval: 60s
      timeout: 70s

  pprof/caddy_goroutine:
    remote:
      endpoint: http://127.0.0.1:2019/debug/pprof/goroutine
      collection_interval: 60s
%{ endif ~}

  journald:
    directory: /var/log/journal

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 150
    spike_limit_mib: 30

  batch: {}

  # The scope would otherwise become two labels on every series
  transform/drop_scope:
    metric_statements:
      - set(scope.name, "")
      - set(scope.version, "")
%{ if type == "app" ~}

  filter/docker_stats:
    metrics:
      metric:
        - not (name == "container.memory.usage.total" or name == "container.memory.usage.limit")

  # job and instance come from the service.* attributes; name keeps cAdvisor's
  # label, which the alert's summary reads
  transform/docker_stats:
    metric_statements:
      - set(datapoint.attributes["name"], resource.attributes["container.name"])
      - set(resource.attributes["service.namespace"], "integrations")
      - set(resource.attributes["service.name"], "docker_stats")
      - set(resource.attributes["service.instance.id"], "${name}")

  # Named as Alloy's were
  resource/caddy_profiles:
    attributes:
      - key: service.name
        value: caddy
        action: upsert
      - key: instance
        value: ${name}
        action: upsert

  filter/memcached:
    metrics:
      metric:
        - not (name == "memcached.bytes" or name == "memcached.current_items" or name == "memcached.evictions" or name == "memcached.commands" or name == "memcached.operations")

  transform/memcached:
    metric_statements:
      - set(resource.attributes["service.namespace"], "integrations")
      - set(resource.attributes["service.name"], "memcached")
      - set(resource.attributes["service.instance.id"], "${name}")

  # The name without its generation becomes service_name, so queries need no
  # regular expression. The rest repeats what Alloy's loki.process did.
  transform/containers:
    error_mode: silent
    log_statements:
      - set(log.attributes["container.name"], log.attributes["container_name"])
      - replace_pattern(log.attributes["container.name"], "^/", "")
      - set(log.attributes["container.id"], log.attributes["container_id"])
      - delete_matching_keys(log.attributes, "^(container_name|container_id|fluent\\.tag)$")
      - set(log.attributes["service.name"], log.attributes["container.name"])
      - replace_pattern(log.attributes["service.name"], "-[0-9]+$", "")

      - 'set(log.body, ExtractPatterns(log.body, "^NOTICE: PHP message: (?P<line>\\{.*)$")["line"]) where log.attributes["service.name"] == "fastcgi" and IsMatch(log.body, "^NOTICE: PHP message: \\{")'
      # Its own service_name lets the rules waiting on its finish line read only it
      - 'set(log.attributes["service.name"], "publish-dump") where log.attributes["service.name"] == "fastcgi" and IsMatch(log.body, "^publish-dump: ")'
      - set(log.attributes["class"], ParseJSON(log.body)["context"]["exception"]["class"]) where log.attributes["service.name"] == "fastcgi" and IsMatch(log.body, "\"caught_by\":\"entrypoint\"|\"channel\":\"fatal\"")

      # php-fpm's copy of a deprecation is counted and dropped; MediaWiki's,
      # which has the URL, is kept at one a minute for each
      - 'set(log.cache["deprecated"], log.body) where log.attributes["service.name"] == "fastcgi" and IsMatch(log.body, "^NOTICE: PHP message: PHP Deprecated: ")'
      - 'set(log.cache["deprecated"], ParseJSON(log.body)["context"]["exception"]["message"]) where log.attributes["service.name"] == "fastcgi" and IsMatch(log.body, "\"channel\":\"error\"") and IsMatch(log.body, "PHP Deprecated: ")'
      - 'merge_maps(log.attributes, ExtractPatterns(log.cache["deprecated"], "PHP Deprecated: +(?P<deprecation>.*?)(?: \\[Called from .*)?(?: in /\\S+ on line \\d+)?$"), "upsert") where log.cache["deprecated"] != nil'
      - 'merge_maps(log.attributes, ExtractPatterns(log.cache["deprecated"], "PHP Deprecated: +Use of (?P<deprecation>\\S+) was deprecated"), "upsert") where log.cache["deprecated"] != nil'
      - 'merge_maps(log.attributes, ExtractPatterns(log.cache["deprecated"], "PHP Deprecated: .*<br>(?P<deprecation>[^<]*?) is deprecated\\."), "upsert") where log.cache["deprecated"] != nil'

      # A refused request's access log line is cut down to what the scrapes
      # dashboard reads
      - set(log.cache["request"], ParseJSON(log.body)["request"]) where log.attributes["service.name"] == "http" and IsMatch(log.body, "\"status\":429")
      - 'set(log.body, {"msg": "refused", "client_ip": log.cache["request"]["client_ip"], "uri": log.cache["request"]["uri"]}) where log.cache["request"] != nil'

      - set(log.attributes["zone"], ParseJSON(log.body)["zone"]) where log.attributes["service.name"] == "http" and IsMatch(log.body, "\"logger\":\"http\\.handlers\\.rate_limit\"") and IsMatch(log.body, "rate limit exceeded")

      # From the access log, not Caddy's metrics: those count the skipped static
      # images and cannot tell the 503 fallback apart
      - set(log.cache["access"], ParseJSON(log.body)) where log.attributes["service.name"] == "http" and IsMatch(log.body, "\"logger\":\"http\\.log\\.access")
      - set(log.attributes["status_class"], Substring(String(Int(log.cache["access"]["status"])), 0, 1)) where log.cache["access"] != nil
      - set(log.attributes["fallback"], String(log.cache["access"]["fallback"])) where log.cache["access"] != nil and log.cache["access"]["fallback"] != nil

  filter/containers:
    error_mode: silent
    logs:
      log_record:
        - 'attributes["service.name"] == "fastcgi" and IsMatch(body, "^NOTICE: PHP message: PHP Deprecated: ")'
        # php-fpm's own access log repeats what Caddy's says about the same request
        - attributes["service.name"] == "fastcgi" and IsMatch(body, "^127\\.0\\.0\\.1 - ")
        - 'attributes["service.name"] == "fastcgi" and IsMatch(body, "\"channel\":\"memcached\"") and IsMatch(body, "Duplicate get\\(\\): ")'
        # The refusal counter is all that reads them
        - attributes["zone"] != nil

  log_dedup/deprecations:
    interval: 60s
    conditions:
      - log.attributes["deprecation"] != nil
    include_fields: [attributes.deprecation]

  groupbyattrs/containers:
    keys: [service.name, container.name]

  # Docker stamps lines in whole seconds, and delta_to_cumulative drops a count
  # no later than the one before, so a count takes the time it was made
  transform/count_time:
    metric_statements:
      - set(datapoint.time, Now())

  # Cumulative, as the remote write exporter takes, and kept a day so a rare
  # counter does not start over
  delta_to_cumulative:
    max_stale: 24h

  # A count comes for every line Docker sends. Remote write gets the latest total
  # once a minute, as from Alloy's scraped counters, not one request per line.
  interval/counts:
    interval: 60s

  transform/counts:
    metric_statements:
      - set(resource.attributes["service.namespace"], "integrations")
      - set(resource.attributes["service.name"], "logs")
      - set(resource.attributes["service.instance.id"], "${name}")
%{ endif ~}

  # The unit becomes service_name, one of the labels Loki indexes by default
  transform/journald:
    log_statements:
      - set(log.attributes["service.name"], log.body["_SYSTEMD_UNIT"])
      - set(log.attributes["service.name"], log.body["SYSLOG_IDENTIFIER"]) where log.attributes["service.name"] == nil
      - set(log.severity_number, SEVERITY_NUMBER_ERROR) where log.body["PRIORITY"] == "3"
      - set(log.severity_number, SEVERITY_NUMBER_WARN) where log.body["PRIORITY"] == "4"
      - set(log.body, log.body["MESSAGE"])

  groupbyattrs/service:
    keys: [service.name]

  transform/host:
    log_statements:
      - set(resource.attributes["host.name"], "${name}")
%{ if type == "app" ~}

connectors:
  forward/containers: {}

  # Named as Alloy's were, so the queries and their history carry over
  count/containers:
    logs:
      loki_process_custom_responses:
        description: Access log lines by the status's first digit, 0 for none
        conditions:
          - attributes["status_class"] != nil
        attributes:
          - key: status_class
          - key: fallback
            default_value: "false"
      loki_process_custom_uncaught_exceptions:
        description: Exceptions that reached the reader as an error page, by class
        conditions:
          - attributes["class"] != nil
        attributes:
          - key: class
      loki_process_custom_php_deprecations:
        description: PHP Deprecated messages, by what is deprecated
        conditions:
          - 'attributes["deprecation"] != nil and IsMatch(body, "^NOTICE: PHP message: PHP Deprecated: ")'
        attributes:
          - key: deprecation
      loki_process_custom_rate_limit_refusals:
        description: Requests Caddy's rate_limit refused, by zone
        conditions:
          - attributes["zone"] != nil
        attributes:
          - key: zone
%{ endif ~}

exporters:
  prometheus_remote_write/metrics_service:
    endpoint: "${prometheus_endpoint}"
    auth:
      authenticator: basicauth/metrics_service
    # job and instance are enough; nothing reads target_info
    target_info:
      enabled: false

  otlphttp/logs_service:
    endpoint: "${loki_endpoint}"
    auth:
      authenticator: basicauth/logs_service
%{ if type == "app" ~}

  otlphttp/profiles_service:
    endpoint: "${pyroscope_endpoint}"
    auth:
      authenticator: basicauth/profiles_service
%{ endif ~}

service:
  extensions: [basicauth/metrics_service, basicauth/logs_service%{ if type == "app" }, basicauth/profiles_service%{ endif }]

  telemetry:
    logs:
      level: warn
    metrics:
      level: basic
      readers:
        - pull:
            exporter:
              prometheus:
                host: 127.0.0.1
                port: 8888

  pipelines:
    metrics/scraped:
      receivers: [prometheus]
      processors: [memory_limiter, transform/drop_scope, batch]
      exporters: [prometheus_remote_write/metrics_service]
%{ if type == "app" ~}

    metrics/docker_stats:
      receivers: [docker_stats]
      processors: [memory_limiter, filter/docker_stats, transform/docker_stats, transform/drop_scope, batch]
      exporters: [prometheus_remote_write/metrics_service]

    metrics/memcached:
      receivers: [memcached]
      processors: [memory_limiter, filter/memcached, transform/memcached, transform/drop_scope, batch]
      exporters: [prometheus_remote_write/metrics_service]

    logs/containers:
      receivers: [fluent_forward]
      processors: [memory_limiter, transform/containers]
      exporters: [count/containers, forward/containers]

    logs/containers_kept:
      receivers: [forward/containers]
      processors: [filter/containers, log_dedup/deprecations, groupbyattrs/containers, transform/host, batch]
      exporters: [otlphttp/logs_service]

    metrics/log_counts:
      receivers: [count/containers]
      processors: [transform/count_time, delta_to_cumulative, interval/counts, transform/counts, transform/drop_scope, batch]
      exporters: [prometheus_remote_write/metrics_service]

    profiles/caddy:
      receivers: [pprof/caddy_cpu, pprof/caddy_goroutine]
      processors: [memory_limiter, resource/caddy_profiles]
      exporters: [otlphttp/profiles_service]
%{ endif ~}

    logs/journald:
      receivers: [journald]
      processors: [memory_limiter, transform/journald, groupbyattrs/service, transform/host, batch]
      exporters: [otlphttp/logs_service]
